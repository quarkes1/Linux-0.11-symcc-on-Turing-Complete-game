    add r2, r2, 4
    load_32 r4, [r2]
    store_32 [r1], r4
    add r1, r1, 4
    add r2, r2, 4
    load_32 r4, [r2]
    store_32 [r1], r4
    add r1, r1, 4
    add r2, r2, 4
    load_32 r4, [r2]
    store_32 [r1], r4
    add r1, r1, 4
    add r2, r2, 4
    sub r3, r3, 32
    jmp sp_copy_loop
sp_copy_tail:
    cmp r3, 0
    je sp_copy_done
    load_32 r4, [r2]
    store_32 [r1], r4
    add r1, r1, 4
    add r2, r2, 4
    sub r3, r3, 4
    jmp sp_copy_tail
sp_copy_done:
    ret
sp_zero:
    add r9, sp, 4
    load_32 r1, [r9]
    add r9, sp, 8
    load_32 r2, [r9]
sp_zero_loop:
    cmp r2, 32
    jb sp_zero_tail
    store_32 [r1], zr
    add r1, r1, 4
    store_32 [r1], zr
    add r1, r1, 4
    store_32 [r1], zr
    add r1, r1, 4
    store_32 [r1], zr
    add r1, r1, 4
    store_32 [r1], zr
    add r1, r1, 4
    store_32 [r1], zr
    add r1, r1, 4
    store_32 [r1], zr
    add r1, r1, 4
    store_32 [r1], zr
    add r1, r1, 4
    sub r2, r2, 32
    jmp sp_zero_loop
sp_zero_tail:
    cmp r2, 0
    je sp_zero_done
    store_32 [r1], zr
    add r1, r1, 4
    sub r2, r2, 4
    jmp sp_zero_tail
sp_zero_done:
    ret
.sym sp_syscall_entry T text 0 0
.sym sp_resume T text 0 0
.sym sp_keyboard_event T text 0 0
.sym sp_time_low T text 0 0
