# 构建产物（Windows exe 与编译器/汇编器输出）
*.exe
*.asm
*.bin
*.sym

# runtime/crt0.asm 是编译器读取的源码（crt0 模板），必须跟踪
!runtime/crt0.asm

# 汇编器/模拟器/编译器输出文件
tests/*.asm
tests/*.bin

!runtime/platform.sym
!user/lib/crt0.sym
!user/lib/syscall.sym
__pycache__/
*.o
!runtime/crt0_interactive.asm
*.spx

.superpowers/
/build/
tests/*.tmp
